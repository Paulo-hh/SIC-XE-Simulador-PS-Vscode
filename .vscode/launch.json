{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Main",
            "request": "launch",
            "mainClass": "application.Main",
            "vmArgs": "--module-path \"${workspaceFolder}/javafx-sdk/lib\" --add-modules javafx.controls,javafx.base,javafx.fxml,javafx.graphics"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ]
}